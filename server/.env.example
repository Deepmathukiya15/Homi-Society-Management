# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────
# Leave blank to boot on the built-in in-memory Mongo-compatible store
# (great for demos / viva). Add an Atlas or local URI for real persistence.
MONGODB_URI=
AUTO_SEED=true

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=homi_super_secret_change_me_in_production
JWT_EXPIRES_IN=7d

# Master passkeys required during Admin / Guard self-registration
ADMIN_MASTER_CODE=ADM-001
GUARD_MASTER_CODE=SEC-001

# ── Razorpay (optional) ───────────────────────────────────────────────────
# Add test keys to use the live Razorpay order flow. If empty, HOMI runs the
# same HMAC-SHA256 verification against a locally signed simulated order.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
