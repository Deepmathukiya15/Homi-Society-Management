# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# 1-Click demo accounts are enabled by default in development and disabled in production.
DEMO_LOGIN_ENABLED=true

# ── Database ──────────────────────────────────────────────────────────────
# Local development can use the built-in in-memory store. Production requires MongoDB;
# it will refuse to start without a working URI.
MONGODB_URI=
# Demo data auto-seeds only outside production.
AUTO_SEED=true

# ── Auth ──────────────────────────────────────────────────────────────────
# Production requires a unique, high-entropy JWT_SECRET.
JWT_SECRET=homi_super_secret_change_me_in_production
JWT_EXPIRES_IN=7d

# Master passkeys required during Admin / Guard self-registration (use unique values in production)
ADMIN_MASTER_CODE=ADM-001
GUARD_MASTER_CODE=SEC-001

# ── Razorpay (optional) ───────────────────────────────────────────────────
# Add Razorpay keys to enable live online payments. Without keys, development
# uses a simulated checkout; online payments are disabled in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
